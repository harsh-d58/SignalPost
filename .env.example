# Optional. Registry, Wikidata and company-site discovery work without credentials.
# Use only a NAV credential approved for this deployment and public output.
# Leave empty to keep the NAV feed blocked. Never put a real token in this file.
NAV_FEED_TOKEN=

# The agent does not automatically read .env files.
# Copy this file to .env, then load it explicitly when starting the backend:
# uv run --frozen --group dev --env-file .env signalpost serve --port 8765
# Restart the backend after changing .env so child jobs inherit the new value.
# Run limits, input paths and snapshot dates are CLI arguments, not env settings.

# Website strategy is a CLI option, not an environment variable:
# --website-strategy legacy (default via auto) or breadth (experimental).
# No LLM/search API keys are required or configured by this revision.
