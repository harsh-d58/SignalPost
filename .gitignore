# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-audit/
.uv-cache/
.test-tmp/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets / local config (keys are only ever passed via environment variables)
.env
.env.*
!.env.example
.claude/settings.local.json

# Large downloaded data (universe, Brreg bulk files) — re-downloadable, never committed
data/

# Run outputs (committed evidence lives in reports/ instead)
out/
out-*/
# Private evidence remains local even when a custom output directory is used.
snapshots/
# Generated Pages build and release archive; rebuild from the submitted commit.
/_site/
/signalpost-code.zip
*.tmp
*.log

# Personal scratch batches
my-*.jsonl

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local agent skills (dev tooling, not part of the submission)
.agents/
.claude/skills/
skills-lock.json
node_modules/
package-lock.json
